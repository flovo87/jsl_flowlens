// ============================================================
// JSL FlowLens v0.5.0
// Understand any JMP script: JSL, Python, JMP Notebooks or a whole
// add-in - explained, animated and traceable to the source lines.
//
// Requires: JMP 18 or newer (Python is built in - no setup needed).
// License: MIT. Copyright (c) 2026 Florian.
// ============================================================

Names Default To Here(1);

sl_version = "0.5.0";
sl_build = "2026-08-07";
sl_addin_id = "FVT.JSLFlowLens";
sl_settings_path = "$DOCUMENTS/JSL_FlowLens_Settings.txt";

// ------------------------------------------------------------
// Locate program folder (add-in home; falls back to a picker
// during development when the add-in is not installed)
// ------------------------------------------------------------
sl_home = "";
Try(
	sl_home = Convert File Path("$ADDIN_HOME(" || sl_addin_id || ")/", Absolute)
);
If(Is Missing(sl_home) | sl_home == "" | !File Exists(sl_home || "flowlens_parser.py"),
	sl_home = Pick Directory("JSL FlowLens: select the program folder (contains flowlens_parser.py)");
	sl_home = Convert File Path(sl_home, Absolute);
);

// ------------------------------------------------------------
// Settings (persisted as key=value lines)
// ------------------------------------------------------------
sl_settings = [
	"provider" => "anthropic",
	"endpoint" => "https://api.anthropic.com/v1/messages",
	"model" => "claude-sonnet-4-5",
	"apikey" => "",
	"lang" => "en"
];

LoadSettings_func = Function({},
	{txt, lines, i, p, key, val},
	Try(
		txt = Load Text File(sl_settings_path);
		lines = Words(txt, "\!n");
		For(i = 1, i <= N Items(lines), i++,
			p = Contains(lines[i], "=");
			If(p > 1,
				key = Trim(Left(lines[i], p - 1));
				val = Trim(Substr(lines[i], p + 1));
				sl_settings[key] = val;
			);
		);
	);
);

SaveSettings_func = Function({},
	{keys, txt, i},
	keys = sl_settings << Get Keys;
	txt = "";
	For(i = 1, i <= N Items(keys), i++,
		txt = txt || keys[i] || "=" || Char(sl_settings[keys[i]]) || "\!n"
	);
	Try(Save Text File(sl_settings_path, txt));
);

LoadSettings_func();

